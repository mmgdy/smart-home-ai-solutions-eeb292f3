# Supabase - get these from your Supabase project settings > API
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"


# Social Automation (Meta Graph API + Threads API + LinkedIn API + Supabase Storage)
META_ACCESS_TOKEN="your-long-lived-meta-access-token"
IG_USER_ID="your-instagram-business-account-id"
FB_PAGE_ID="your-facebook-page-id"
FB_PAGE_ACCESS_TOKEN="optional-page-token-defaults-to-META_ACCESS_TOKEN"
THREADS_USER_ID="your-threads-user-id"
THREADS_ACCESS_TOKEN="optional-threads-token-defaults-to-META_ACCESS_TOKEN"
LINKEDIN_ACCESS_TOKEN="your-linkedin-oauth2-access-token"
LINKEDIN_ORG_URN="urn:li:organization:YOUR_COMPANY_ID"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-for-media-upload"
SUPABASE_VIDEO_BUCKET="social-videos"
